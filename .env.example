# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
HELIUS_API_KEY=
BIRDEYE_API_KEY=
DUNE_API_KEY=
FOMOSCAN_API_KEY=
# Optional override for compatible FomoScan deployments.
FOMOSCAN_BASE=https://api.fomoscan.sh
WEBHOOK_SECRET=

# Optional local JSON store location. Defaults to .data/whoaped.json.
WHOAPED_DATA_FILE=
# Deprecated compatibility names; remove after stored deployments migrate.
WHOHELD_DATA_FILE=
FOLLOWER_ALPHA_DATA_FILE=

# Shared production database (server-only service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
WHOAPED_SUPABASE_GATEWAY_SECRET=

# Internal server-to-server worker authentication.
WORKER_SECRET=
CRON_SECRET=
# The Fomo collector derives its AES-256 session key from WORKER_SECRET.
# Connect a dedicated account once with: pnpm fomo:connect

# Production Fomo browser persistence. Browserbase Contexts retain the complete
# browser profile between Vercel invocations; keep the API key server-only.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_CONTEXT_ID=
