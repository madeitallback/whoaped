HELIUS_API_KEY=
# Optional override. Defaults to the public Solana mainnet RPC when unset.
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
FOMOSCAN_API_KEY=
FOMOSCAN_BASE=https://api.fomoscan.sh
FOMOTAGS_BASE=https://api.fomotags.xyz
BIRDEYE_API_KEY=
DUNE_API_KEY=              # server-side Dune Data API key
# Set these after saving the SQL files in ./dune as private Dune queries.
DUNE_VENUES_QUERY_ID=
DUNE_BUYERS_QUERY_ID=
DUNE_SUMMARY_QUERY_ID=
DUNE_SIGNALS_QUERY_ID=
# Optional daily-balance backfill. Create ./dune/05_daily_holder_balances.sql
# as a private Dune query, then set its id here. It is never run when unset.
DUNE_BALANCE_HISTORY_QUERY_ID=

# Server-side Supabase persistence. Never expose this key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_

# Internal token used only by Supabase Cron to invoke /api/worker after deploy.
WORKER_SECRET=
